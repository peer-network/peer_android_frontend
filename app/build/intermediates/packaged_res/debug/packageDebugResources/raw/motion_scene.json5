{
  ConstraintSets: {
    start: {
      logo: {
        width: 200,
        height: 200,
        centerHorizontally: 'parent',
        top: ['parent', 'top', 250],
      }
    },
    end: {
      logo: {
        width: 150,
        height: 150,
        centerHorizontally: 'parent',
        top: ['parent', 'top', 56],
        translationY: -200
      }
    }
  },
  Transitions: {
    default: {
      from: 'start',
      to: 'end',
      pathMotionArc: 'startVertical',
      interpolator: "easeIn",
      KeyFrames: {
        KeyAttributes: [
          {
            target: ['logo'],
            frames: [0, 100],
            translationY: [0, 100]
          }
        ]
      }
    }
  }
}